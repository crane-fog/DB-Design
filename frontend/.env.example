# API 基址。默认留空，使用同源 /api 路径；页面中不得硬编码完整接口地址。
VITE_API_BASE_URL=

# Vite 开发服务器将 /api 代理至此地址，默认后端端口为 5000。
VITE_API_PROXY_TARGET=http://localhost:5000

# 工作台 Mock 开关和场景：只在开发环境有效。
VITE_USE_DASHBOARD_MOCK=true
VITE_DASHBOARD_MOCK_SCENARIO=success

# 物料、库存和采购 Mock 开关相互独立，只在开发环境有效。
# 对应后端 API 可用后，请逐模块设为 false；关闭后不会回退成 Mock 成功结果。
VITE_USE_MATERIAL_MOCK=true
VITE_USE_INVENTORY_MOCK=true
VITE_USE_PURCHASE_MOCK=true

# 仅本地 Vite 开发环境可用的 Mock 登录；生产构建会强制禁用。
VITE_USE_MOCK_AUTH=true
